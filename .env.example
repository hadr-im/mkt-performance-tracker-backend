# Copy to .env and fill in. Placeholders only — never put real values here.

# Service account JSON on a single line. Share the spreadsheet with this
# account's client_email (Viewer) and enable the Google Sheets API.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# Or, instead of the above, a path to the key file:
# GOOGLE_APPLICATION_CREDENTIALS=./mkt-tracker.json

# Spreadsheet to read. Required.
SHEETS_ID=your-spreadsheet-id

# Optional tab overrides. The signups tab is required; the other two are
# optional and their absence is reported to the UI rather than faked as zero.
# SHEET_TAB_SIGNUPS=Eps Leads Mirror
# SHEET_TAB_APPLICATIONS=Expa Application
# SHEET_TAB_MEMBERS=Members Info

CACHE_TTL_SECONDS=60
PORT=4000

# Comma-separated browser origins allowed to call this API.
# This is an allowlist — a deployed frontend missing from it is blocked.
FRONTEND_URL=http://localhost:3000

# Optional shared secret; when set, /api requests must present it.
# API_TOKEN=generate-with-openssl-rand-base64-32
